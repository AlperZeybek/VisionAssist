{
  "name": "visionassist",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --passWithNoTests"
  },
  "jest": {
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.(ts|tsx|js|jsx)$": "babel-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules/(?!(expo-haptics|expo-speech|expo-location|@react-native-async-storage)/)"
    ],
    "moduleNameMapper": {
      "^react-native-vision-camera$": "<rootDir>/__mocks__/react-native-vision-camera.js",
      "^react-native-worklets-core$": "<rootDir>/__mocks__/react-native-worklets-core.js",
      "^vision-camera-resize-plugin$": "<rootDir>/__mocks__/vision-camera-resize-plugin.js",
      "^react-native-fast-tflite$": "<rootDir>/__mocks__/react-native-fast-tflite.js",
      "^expo-haptics$": "<rootDir>/__mocks__/expo-haptics.js",
      "^expo-speech$": "<rootDir>/__mocks__/expo-speech.js"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.14",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-location": "~19.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fast-tflite": "^2.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets-core": "^1.6.3",
    "vision-camera-resize-plugin": "^3.2.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-shorthand-properties": "^7.27.1",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "jest-expo": "^56.0.4",
    "jest-mock": "^29.7.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
