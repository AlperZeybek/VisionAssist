{
  "expo": {
    "name": "VisionAssist",
    "slug": "VisionAssist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VisionAssist engelleri tespit etmek için kameranıza erişim gerektirir.",
        "NSSpeechRecognitionUsageDescription": "VisionAssist sesli rehberlik sağlamak için konuşma erişimi gerektirir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "VisionAssist engelleri tespit etmek için kameranıza erişim gerektirir."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "VisionAssist engelleri tespit etmek için kameranıza erişim gerektirir.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0582677f-d2a4-42ce-9091-a8050cda807e"
      }
    }
  }
}
